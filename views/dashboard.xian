{{> head}}
<body class="bg-gray-100">
<div style="display:flex">
  {{> sidebar}}
  <div style="margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column">
    {{> topbar}}
    <div style="padding:28px">

      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-bottom:24px">
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="width:48px;height:48px;background:rgba(239,68,68,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem">💰</div>
          <div><div style="font-size:1.4rem;font-weight:700">₱{{totalSales}}</div><div style="font-size:.75rem;color:#888">Total Sales</div></div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="width:48px;height:48px;background:rgba(0,119,255,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem">📋</div>
          <div><div style="font-size:1.4rem;font-weight:700">{{totalOrders}}</div><div style="font-size:.75rem;color:#888">Orders</div></div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="width:48px;height:48px;background:rgba(0,200,100,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem">🧾</div>
          <div><div style="font-size:1.4rem;font-weight:700">{{totalPOS}}</div><div style="font-size:.75rem;color:#888">POS Sales</div></div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="width:48px;height:48px;background:rgba(255,140,0,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem">📦</div>
          <div><div style="font-size:1.4rem;font-weight:700">{{totalProducts}}</div><div style="font-size:.75rem;color:#888">Products</div></div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="width:48px;height:48px;background:rgba(130,0,255,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem">👥</div>
          <div><div style="font-size:1.4rem;font-weight:700">{{totalUsers}}</div><div style="font-size:.75rem;color:#888">Users</div></div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:20px">
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div style="font-size:1rem;font-weight:600;margin-bottom:16px;color:#1a1a2e;border-bottom:2px solid #f0f2f5;padding-bottom:10px">📋 Recent Orders</div>
          <table class="w-full text-sm">
            <thead><tr class="text-left text-gray-500 text-xs"><th class="pb-2">#ID</th><th class="pb-2">Customer</th><th class="pb-2">Amount</th><th class="pb-2">Status</th></tr></thead>
            <tbody>{{{recentOrderRows}}}</tbody>
          </table>
          <div class="mt-3"><a href="/orders" class="text-xs text-red-500 hover:underline">View All Orders →</a></div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div style="font-size:1rem;font-weight:600;margin-bottom:16px;color:#1a1a2e;border-bottom:2px solid #f0f2f5;padding-bottom:10px">⚠️ Low Stock</div>
          <table class="w-full text-sm">
            <thead><tr class="text-left text-gray-500 text-xs"><th class="pb-2">Product</th><th class="pb-2">Stock</th></tr></thead>
            <tbody>{{{lowStockRows}}}</tbody>
          </table>
          <div class="mt-3"><a href="/products" class="text-xs text-red-500 hover:underline">Manage Products →</a></div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px">
        <a href="/pos" class="bg-white rounded-xl p-6 shadow-sm text-center block hover:shadow-md transition">
          <div style="font-size:2rem;margin-bottom:8px">🧾</div>
          <div class="font-semibold">Open POS Terminal</div>
          <div class="text-xs text-gray-400 mt-1">Process walk-in sales</div>
        </a>
        <a href="/orders" class="bg-white rounded-xl p-6 shadow-sm text-center block hover:shadow-md transition">
          <div style="font-size:2rem;margin-bottom:8px">📋</div>
          <div class="font-semibold">Manage Orders</div>
          <div class="text-xs text-gray-400 mt-1">View and update orders</div>
        </a>
        <a href="/accounting/report" class="bg-white rounded-xl p-6 shadow-sm text-center block hover:shadow-md transition">
          <div style="font-size:2rem;margin-bottom:8px">📈</div>
          <div class="font-semibold">Financial Reports</div>
          <div class="text-xs text-gray-400 mt-1">View income & expenses</div>
        </a>
      </div>

    </div>
    {{> footer}}
  </div>
</div>
</body>
</html>
