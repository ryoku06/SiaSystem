{{> head}}
<body class="bg-gray-100">
<div style="display:flex">
  {{> sidebar}}
  <div style="margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column">
    {{> topbar}}
    <div style="padding:28px">

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px">
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="width:48px;height:48px;background:rgba(0,200,100,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem">📈</div>
          <div><div style="font-size:1.4rem;font-weight:700;color:#00a854">₱{{totalCredit}}</div><div style="font-size:.75rem;color:#888">Total Revenue</div></div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="width:48px;height:48px;background:rgba(239,68,68,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem">📉</div>
          <div><div style="font-size:1.4rem;font-weight:700;color:#ef4444">₱{{totalDebit}}</div><div style="font-size:.75rem;color:#888">Total Expenses</div></div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="width:48px;height:48px;background:rgba(0,119,255,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem">💵</div>
          <div><div style="font-size:1.4rem;font-weight:700">₱{{netIncome}}</div><div style="font-size:.75rem;color:#888">Net Income</div></div>
        </div>
      </div>

      <div class="bg-white rounded-xl p-6 shadow-sm mb-6">
        <div style="font-size:1rem;font-weight:600;margin-bottom:16px;border-bottom:2px solid #f0f2f5;padding-bottom:10px">➕ Add Expense</div>
        <form method="POST" action="/accounting/expense">
          <div style="display:flex;gap:16px;align-items:flex-end">
            <div class="flex flex-col gap-1" style="flex:2">
              <label class="text-xs font-semibold text-gray-600">Description *</label>
              <input type="text" name="description" required placeholder="e.g. Office supplies purchased" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div class="flex flex-col gap-1" style="flex:1">
              <label class="text-xs font-semibold text-gray-600">Amount (₱) *</label>
              <input type="number" name="amount" step="0.01" min="0.01" required placeholder="0.00" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg text-sm font-semibold transition">Add Expense</button>
          </div>
        </form>
      </div>

      <div class="bg-white rounded-xl p-6 shadow-sm">
        <div style="display:flex;justify-content:space-between;align-items:center;font-size:1rem;font-weight:600;margin-bottom:16px;border-bottom:2px solid #f0f2f5;padding-bottom:10px">
          <span>💰 Accounting Entries</span>
          <a href="/accounting/report" class="text-xs text-red-500 hover:underline">View Report →</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 text-left text-xs text-gray-500">
              <th class="p-3">#</th><th class="p-3">Reference</th><th class="p-3">Amount</th><th class="p-3">Type</th><th class="p-3">Description</th><th class="p-3">Date</th>
            </tr></thead>
            <tbody>{{{rows}}}</tbody>
          </table>
        </div>
      </div>

    </div>
    {{> footer}}
  </div>
</div>
</body>
</html>
