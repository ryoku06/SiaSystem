{{> head}}
<body class="bg-gray-100">
<div style="display:flex">
  {{> sidebar}}
  <div style="margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column">
    {{> topbar}}
    <div style="padding:28px">

      <div class="bg-white rounded-xl p-6 shadow-sm mb-6">
        <div style="font-size:1rem;font-weight:600;margin-bottom:16px;border-bottom:2px solid #f0f2f5;padding-bottom:10px">➕ Add New User</div>
        <form method="POST" action="/users/create">
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px">
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">Full Name *</label>
              <input type="text" name="name" required placeholder="Juan Dela Cruz" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">Email *</label>
              <input type="email" name="email" required placeholder="user@email.com" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">Password *</label>
              <input type="password" name="password" required placeholder="Min 6 characters" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">Role</label>
              <select name="role" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
                <option value="customer">Customer</option>
                <option value="cashier">Cashier</option>
                <option value="admin">Admin</option>
              </select>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">Address</label>
              <input type="text" name="address" placeholder="Street, City" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div class="flex items-end">
              <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg text-sm font-semibold transition">Create User</button>
            </div>
          </div>
        </form>
      </div>

      <div class="bg-white rounded-xl p-6 shadow-sm">
        <div style="font-size:1rem;font-weight:600;margin-bottom:16px;border-bottom:2px solid #f0f2f5;padding-bottom:10px">👥 User List</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 text-left text-xs text-gray-500">
              <th class="p-3">#</th><th class="p-3">Name</th><th class="p-3">Email</th><th class="p-3">Role</th><th class="p-3">Status</th><th class="p-3">Actions</th>
            </tr></thead>
            <tbody>{{{rows}}}</tbody>
          </table>
        </div>
      </div>

    </div>
    {{> footer}}
  </div>
</div>
</body>
</html>
