{{> head}}
<body class="bg-gray-100">
<div style="display:flex">
  {{> sidebar}}
  <div style="margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column">
    {{> topbar}}
    <div style="padding:28px">
      <div class="bg-white rounded-xl p-6 shadow-sm" style="max-width:500px">
        <div style="font-size:1rem;font-weight:600;margin-bottom:16px;border-bottom:2px solid #f0f2f5;padding-bottom:10px">✏️ Edit Category</div>
        <form method="POST" action="/categories/edit/{{catId}}">
          <div class="flex flex-col gap-1 mb-4">
            <label class="text-xs font-semibold text-gray-600">Category Name *</label>
            <input type="text" name="name" value="{{catName}}" required class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
          </div>
          <div class="flex flex-col gap-1 mb-5">
            <label class="text-xs font-semibold text-gray-600">Description</label>
            <input type="text" name="description" value="{{catDesc}}" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
          </div>
          <div style="display:flex;gap:12px">
            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg text-sm font-semibold transition">Save</button>
            <a href="/categories" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg text-sm transition">Cancel</a>
          </div>
        </form>
      </div>
    </div>
    {{> footer}}
  </div>
</div>
</body>
</html>
