{{> head}}
<body class="bg-gray-100">
<div style="display:flex">
  {{> sidebar}}
  <div style="margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column">
    {{> topbar}}
    <div style="padding:28px">
      <div class="bg-white rounded-xl p-6 shadow-sm" style="max-width:560px">
        <div style="font-size:1rem;font-weight:600;margin-bottom:16px;border-bottom:2px solid #f0f2f5;padding-bottom:10px">✏️ Edit User</div>
        <form method="POST" action="/users/edit/{{userId}}">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">Full Name *</label>
              <input type="text" name="name" value="{{userName2}}" required class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">Email *</label>
              <input type="email" name="email" value="{{userEmail}}" required class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">New Password <span class="text-gray-400 font-normal">(leave blank to keep)</span></label>
              <input type="password" name="password" placeholder="••••••••" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">Role</label>
              <select name="role" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">{{{roleOptions}}}</select>
            </div>
            <div class="flex flex-col gap-1 col-span-2">
              <label class="text-xs font-semibold text-gray-600">Address</label>
              <input type="text" name="address" value="{{userAddress}}" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-red-400"/>
            </div>
          </div>
          <div class="flex items-center gap-2 mb-5">
            <input type="checkbox" name="isActive" id="isActive" {{isActiveChecked}}/>
            <label for="isActive" class="text-sm font-medium cursor-pointer">Active Account</label>
          </div>
          <div style="display:flex;gap:12px">
            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg text-sm font-semibold transition">Save Changes</button>
            <a href="/users" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg text-sm transition">Cancel</a>
          </div>
        </form>
      </div>
    </div>
    {{> footer}}
  </div>
</div>
</body>
</html>
