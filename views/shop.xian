{{> head}}
<body class="bg-gray-100">
<div style="display:flex">
  {{> sidebar}}
  <div style="margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column">
    {{> topbar}}
    <div style="padding:28px">

      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px">
        <h2 style="font-size:1.2rem;font-weight:700">🛒 Online Shop</h2>
        <div style="display:flex;align-items:center;gap:12px">
          <input type="text" id="shopSearch" placeholder="🔍 Search products..." oninput="filterShop()"
            class="border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-red-400" style="width:240px"/>
        </div>
      </div>

      <div id="catBtns" style="margin-bottom:18px"></div>
      <div id="shopGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:18px"></div>

    </div>
    {{> footer}}
  </div>
</div>

<!-- Cart FAB -->
<button onclick="toggleCart()" style="position:fixed;bottom:24px;right:24px;background:#ef4444;color:#fff;width:56px;height:56px;border-radius:50%;border:none;font-size:1.4rem;cursor:pointer;box-shadow:0 4px 16px rgba(239,68,68,.4);z-index:150;display:flex;align-items:center;justify-content:center">
  🛒<span id="cartBadge" style="position:absolute;top:-4px;right:-4px;background:#1a1a2e;color:#fff;border-radius:50%;width:20px;height:20px;font-size:.68rem;display:flex;align-items:center;justify-content:center;font-weight:700">0</span>
</button>

<!-- Cart Overlay -->
<div id="cartOverlay" onclick="toggleCart()" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:199;display:none"></div>

<!-- Cart Panel -->
<div id="cartPanel" style="position:fixed;right:0;top:0;width:340px;height:100vh;background:#fff;box-shadow:-4px 0 24px rgba(0,0,0,.12);z-index:200;transform:translateX(100%);transition:transform .3s;display:flex;flex-direction:column">
  <div style="padding:20px;border-bottom:1px solid #f0f0f0;display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:1rem">
    <span>🛒 My Cart</span>
    <button onclick="toggleCart()" style="border:none;background:none;font-size:1.2rem;cursor:pointer;color:#aaa">✕</button>
  </div>
  <div id="cartPanelItems" style="flex:1;overflow-y:auto;padding:14px 20px">
    <p style="color:#aaa;text-align:center;padding:20px">Cart is empty</p>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f0f0f0">
    <div style="display:flex;justify-content:space-between;font-weight:700;margin-bottom:12px">
      <span>Total</span><span id="cartPanelTotal" style="color:#ef4444">₱0.00</span>
    </div>
    <button id="checkoutBtn" onclick="openCheckout()" disabled
      style="width:100%;padding:12px;background:#ef4444;color:#fff;border:none;border-radius:10px;font-size:.9rem;font-weight:700;cursor:pointer;transition:background .2s">
      Proceed to Checkout
    </button>
  </div>
</div>

<!-- Checkout Modal -->
<div id="checkoutModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;padding:32px;width:100%;max-width:440px;box-shadow:0 20px 60px rgba(0,0,0,.2)">
    <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:20px">📋 Confirm Order</h2>
    <div id="checkoutSummary" style="background:#f8f8f8;border-radius:10px;padding:16px;margin-bottom:16px;font-size:.85rem;max-height:200px;overflow-y:auto"></div>
    <div class="flex flex-col gap-1 mb-4">
      <label class="text-xs font-semibold text-gray-600">Payment Method</label>
      <select id="shopPayMethod" class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-full">
        <option value="cash">Cash on Delivery</option>
        <option value="gcash">GCash</option>
        <option value="card">Card</option>
      </select>
    </div>
    <div class="flex flex-col gap-1 mb-5">
      <label class="text-xs font-semibold text-gray-600">Order Notes (optional)</label>
      <input type="text" id="shopNotes" placeholder="Special instructions..." class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-full"/>
    </div>
    <div style="display:flex;gap:12px">
      <button onclick="placeOrder()" class="flex-1 bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-lg transition">Place Order</button>
      <button onclick="document.getElementById('checkoutModal').style.display='none'" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 py-3 rounded-lg transition">Cancel</button>
    </div>
  </div>
</div>

<!-- Success Modal -->
<div id="successModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;padding:32px;width:100%;max-width:440px;text-align:center">
    <div style="font-size:3rem;margin-bottom:12px">✅</div>
    <h2 style="margin-bottom:8px;color:#00a854;font-weight:700">Order Placed!</h2>
    <p id="successMsg" style="color:#888;margin-bottom:24px;font-size:.9rem"></p>
    <button onclick="document.getElementById('successModal').style.display='none';shopCart=[];renderShopCart()"
      class="bg-red-500 hover:bg-red-600 text-white font-bold px-8 py-3 rounded-lg transition">Continue Shopping</button>
  </div>
</div>

<script>
const SHOP_PRODUCTS = {{{productsJson}}};
const IS_LOGGED_IN = {{isLoggedIn}};
let shopCart = [];
let activeCat = '';

// Build category buttons
const cats = [...new Set(SHOP_PRODUCTS.map(p => p.category))];
const catBtns = document.getElementById('catBtns');
const makeBtn = (label, val) => {
  const b = document.createElement('button');
  b.textContent = label; b.dataset.cat = val;
  b.style.cssText = 'padding:6px 14px;border-radius:20px;border:1.5px solid #ddd;background:#fff;cursor:pointer;font-size:.8rem;margin-right:6px;margin-bottom:6px;transition:all .2s';
  b.onclick = () => { activeCat = val; document.querySelectorAll('#catBtns button').forEach(x => { x.style.background='#fff'; x.style.borderColor='#ddd'; x.style.color='#333'; }); b.style.background='#ef4444'; b.style.borderColor='#ef4444'; b.style.color='#fff'; renderShopProducts(); };
  return b;
};
const allBtn = makeBtn('All', '');
allBtn.style.background = '#ef4444'; allBtn.style.borderColor = '#ef4444'; allBtn.style.color = '#fff';
catBtns.appendChild(allBtn);
cats.forEach(c => catBtns.appendChild(makeBtn(c, c)));

function filterShop() { renderShopProducts(); }

function renderShopProducts() {
  const q = document.getElementById('shopSearch').value.toLowerCase();
  const filtered = SHOP_PRODUCTS.filter(p => (!activeCat || p.category === activeCat) && (p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q)));
  const grid = document.getElementById('shopGrid');
  if (!filtered.length) { grid.innerHTML = '<p style="color:#aaa;text-align:center;grid-column:1/-1;padding:40px">No products found</p>'; return; }
  grid.innerHTML = filtered.map(p => `
    <div style="background:#fff;border-radius:12px;padding:18px;box-shadow:0 2px 8px rgba(0,0,0,.06);transition:transform .2s;border:2px solid transparent" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='#ef4444'" onmouseout="this.style.transform='';this.style.borderColor='transparent'">
      <div style="font-size:.68rem;color:#ef4444;font-weight:600;text-transform:uppercase;margin-bottom:6px">${p.category}</div>
      <div style="font-size:.95rem;font-weight:700;margin-bottom:4px">${p.name}</div>
      <div style="font-size:.78rem;color:#888;margin-bottom:10px;min-height:32px">${p.description||''}</div>
      <div style="font-size:1.2rem;font-weight:700;color:#ef4444;margin-bottom:4px">₱${p.price}</div>
      <div style="font-size:.72rem;color:#aaa;margin-bottom:12px">Stock: ${p.stock}</div>
      <button onclick="addToShopCart(${p.id})" ${p.stock<=0?'disabled':''} style="width:100%;padding:8px;background:${p.stock>0?'#ef4444':'#ccc'};color:#fff;border:none;border-radius:8px;font-size:.82rem;font-weight:600;cursor:${p.stock>0?'pointer':'not-allowed'};transition:background .2s" ${p.stock>0?'onmouseover="this.style.background=\'#dc2626\'"':''}  ${p.stock>0?'onmouseout="this.style.background=\'#ef4444\'"':''}>
        ${p.stock > 0 ? '+ Add to Cart' : 'Out of Stock'}
      </button>
    </div>`).join('');
}
renderShopProducts();

function addToShopCart(id) {
  if (!IS_LOGGED_IN) { window.location.href = '/login'; return; }
  const p = SHOP_PRODUCTS.find(x => x.id === id);
  if (!p) return;
  const ex = shopCart.find(x => x.id === id);
  if (ex) { if (ex.qty >= p.stock) return alert('Max stock reached'); ex.qty++; }
  else shopCart.push({ id: p.id, name: p.name, price: parseFloat(p.price), qty: 1, stock: p.stock });
  renderShopCart();
}

function renderShopCart() {
  const el = document.getElementById('cartPanelItems');
  const total = shopCart.reduce((s,i) => s + i.price * i.qty, 0);
  document.getElementById('cartBadge').textContent = shopCart.reduce((s,i) => s + i.qty, 0);
  document.getElementById('cartPanelTotal').textContent = '₱' + total.toFixed(2);
  document.getElementById('checkoutBtn').disabled = shopCart.length === 0;
  document.getElementById('checkoutBtn').style.background = shopCart.length ? '#ef4444' : '#ccc';
  if (!shopCart.length) { el.innerHTML = '<p style="color:#aaa;text-align:center;padding:20px">Cart is empty</p>'; return; }
  el.innerHTML = shopCart.map((item,i) => `
    <div style="display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #f8f8f8;font-size:.85rem">
      <div style="flex:1;font-weight:500">${item.name}</div>
      <div style="display:flex;align-items:center;gap:4px">
        <button onclick="changeShopQty(${i},-1)" style="width:24px;height:24px;border:1px solid #ddd;background:#f0f0f0;border-radius:4px;cursor:pointer;font-weight:700">−</button>
        <span style="min-width:24px;text-align:center">${item.qty}</span>
        <button onclick="changeShopQty(${i},1)" style="width:24px;height:24px;border:1px solid #ddd;background:#f0f0f0;border-radius:4px;cursor:pointer;font-weight:700">+</button>
      </div>
      <div style="font-weight:600;color:#ef4444;min-width:65px;text-align:right">₱${(item.price*item.qty).toFixed(2)}</div>
      <span onclick="removeShopItem(${i})" style="cursor:pointer;color:#ccc" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='#ccc'">✕</span>
    </div>`).join('');
}

function changeShopQty(i, d) { shopCart[i].qty += d; if (shopCart[i].qty <= 0) shopCart.splice(i,1); else if (shopCart[i].qty > shopCart[i].stock) shopCart[i].qty = shopCart[i].stock; renderShopCart(); }
function removeShopItem(i) { shopCart.splice(i,1); renderShopCart(); }
function toggleCart() { const p = document.getElementById('cartPanel'), o = document.getElementById('cartOverlay'); const open = p.style.transform === 'translateX(0px)' || p.style.transform === 'translateX(0)'; p.style.transform = open ? 'translateX(100%)' : 'translateX(0)'; o.style.display = open ? 'none' : 'block'; }

function openCheckout() {
  if (!shopCart.length) return;
  const total = shopCart.reduce((s,i) => s + i.price * i.qty, 0);
  document.getElementById('checkoutSummary').innerHTML = shopCart.map(i => `<div style="display:flex;justify-content:space-between;margin-bottom:4px"><span>${i.name} x${i.qty}</span><span>₱${(i.price*i.qty).toFixed(2)}</span></div>`).join('') + `<div style="border-top:1px solid #ddd;margin-top:8px;padding-top:8px;display:flex;justify-content:space-between;font-weight:700"><span>Total</span><span style="color:#ef4444">₱${total.toFixed(2)}</span></div>`;
  document.getElementById('checkoutModal').style.display = 'flex';
  toggleCart();
}

async function placeOrder() {
  const method = document.getElementById('shopPayMethod').value;
  const notes = document.getElementById('shopNotes').value;
  const resp = await fetch('/orders/place', {
    method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body: new URLSearchParams({ items: JSON.stringify(shopCart.map(i=>({productId:i.id,quantity:i.qty}))), paymentMethod:method, notes })
  });
  const data = await resp.json();
  document.getElementById('checkoutModal').style.display = 'none';
  if (data.success) {
    document.getElementById('successMsg').textContent = `Order #${data.orderId} placed! Total: ₱${data.total}. We will process your order shortly.`;
    document.getElementById('successModal').style.display = 'flex';
    shopCart.forEach(item => { const p = SHOP_PRODUCTS.find(x=>x.id===item.id); if(p) p.stock -= item.qty; });
    shopCart = []; renderShopCart(); renderShopProducts();
  } else { alert('Error: ' + data.message); }
}
</script>
