{{> head}}
<body class="bg-gray-100">
<div style="display:flex">
  {{> sidebar}}
  <div style="margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column">
    {{> topbar}}
    <div style="padding:28px">

      <div class="bg-white rounded-xl p-6 shadow-sm mb-6">
        <div style="font-size:1rem;font-weight:600;margin-bottom:16px;border-bottom:2px solid #f0f2f5;padding-bottom:10px">📈 Generate Report</div>
        <form method="GET" action="/accounting/report">
          <div style="display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap">
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">From Date</label>
              <input type="date" name="from" value="{{fromDate}}" class="border border-gray-300 rounded-lg px-3 py-2 text-sm"/>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-xs font-semibold text-gray-600">To Date</label>
              <input type="date" name="to" value="{{toDate}}" class="border border-gray-300 rounded-lg px-3 py-2 text-sm"/>
            </div>
            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg text-sm font-semibold transition">Generate</button>
            <a href="/accounting/report" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg text-sm transition">Reset</a>
          </div>
        </form>
      </div>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px">
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="font-size:1.4rem">📈</div>
          <div><div style="font-size:1.4rem;font-weight:700;color:#00a854">₱{{totalCredit}}</div><div style="font-size:.75rem;color:#888">Total Revenue</div></div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="font-size:1.4rem">📉</div>
          <div><div style="font-size:1.4rem;font-weight:700;color:#ef4444">₱{{totalDebit}}</div><div style="font-size:.75rem;color:#888">Total Expenses</div></div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm flex items-center gap-4">
          <div style="font-size:1.4rem">💵</div>
          <div><div style="font-size:1.4rem;font-weight:700">₱{{netIncome}}</div><div style="font-size:.75rem;color:#888">Net Income</div></div>
        </div>
      </div>

      <div class="bg-white rounded-xl p-6 shadow-sm">
        <div style="font-size:1rem;font-weight:600;margin-bottom:16px;border-bottom:2px solid #f0f2f5;padding-bottom:10px">Entries {{dateRange}}</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 text-left text-xs text-gray-500">
              <th class="p-3">Date</th><th class="p-3">Reference</th><th class="p-3">Description</th>
              <th class="p-3 text-green-600">Income</th><th class="p-3 text-red-500">Expense</th>
            </tr></thead>
            <tbody>{{{rows}}}</tbody>
            <tfoot>
              <tr class="bg-gray-50 font-bold">
                <td colspan="3" class="text-right p-3">Totals:</td>
                <td class="p-3 text-green-600">₱{{totalCredit}}</td>
                <td class="p-3 text-red-500">₱{{totalDebit}}</td>
              </tr>
              <tr class="bg-gray-800 text-white font-bold">
                <td colspan="3" class="text-right p-3">Net Income:</td>
                <td colspan="2" class="p-3">₱{{netIncome}}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

    </div>
    {{> footer}}
  </div>
</div>
</body>
</html>
