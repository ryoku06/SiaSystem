<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>{{title}} — ERP System</title>
  <style>
    .sidebar-link { display:flex;align-items:center;gap:10px;padding:10px 20px;color:rgba(255,255,255,0.7);font-size:.875rem;transition:all .2s;border-left:3px solid transparent; }
    .sidebar-link:hover,.sidebar-link.active { background:rgba(239,68,68,.15);color:#fff;border-left-color:#ef4444; }
    .badge { padding:2px 10px;border-radius:20px;font-size:.72rem;font-weight:600;display:inline-block; }
    .badge-success { background:#e6f9f0;color:#00a854; }
    .badge-danger  { background:#fff0f0;color:#ef4444; }
    .badge-warning { background:#fff8e6;color:#d4900a; }
    .badge-info    { background:#e6f0ff;color:#0066cc; }
    .badge-pending   { background:#fff8e6;color:#d4900a; }
    .badge-confirmed { background:#e6f9f0;color:#00a854; }
    .badge-shipped   { background:#e6f0ff;color:#0066cc; }
    .badge-delivered { background:#e6f9f0;color:#00a854; }
    .badge-cancelled { background:#fff0f0;color:#ef4444; }
    .badge-completed { background:#e6f9f0;color:#00a854; }
    .badge-voided    { background:#fff0f0;color:#ef4444; }
    .badge-credit    { background:#e6f9f0;color:#00a854; }
    .badge-debit     { background:#fff0f0;color:#ef4444; }
    .badge-admin     { background:#f3e6ff;color:#6600cc; }
    .badge-cashier   { background:#e6fff0;color:#006633; }
    .badge-customer  { background:#e6f0ff;color:#003399; }
  </style>
</head>
